# Backend Environment Configuration
# Default is local SQLite. Replace with your Supabase PostgreSQL connection string:
DATABASE_URL=sqlite:///./schoolpath_dev.db

# Supabase connection format example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Target table for school records
TARGET_TABLE=schools

# API Keys & LLM Model for AI & Crawling (Firecrawl, Tavily, OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_INPUT_COST_PER_M=0.10
OPENAI_OUTPUT_COST_PER_M=0.50
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Optional: Remote QA Inspection DB credentials (for safe inspection scripts)
QA_DB_HOST=
QA_DB_PORT=5432
QA_DB_NAME=sdn_qa
QA_DB_USER=
QA_DB_PASSWORD=
